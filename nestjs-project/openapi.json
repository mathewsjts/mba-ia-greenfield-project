          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public video identifier (11 chars, base64url)",
            "schema": {
              "example": "Xk3_9aQ-0bZ",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned stream URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedUrlResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
